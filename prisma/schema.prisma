generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String?
  name      String?
  otp       String?
  otpExpiry DateTime?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  proctoringWarnings ProctoringWarningLog[]
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Test {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  durationMinutes    Int
  totalQuestions     Int      @default(50)
  marksPerQuestion   Float    @default(1.0)
  negativeMarking    Boolean  @default(false)
  negativeMarks      Float    @default(0.0)
  maximumAttempts    Int      @default(1)
  randomizeQuestions Boolean  @default(false)
  randomizeOptions   Boolean  @default(false)
  status             String   @default("DRAFT") // DRAFT, PUBLISHED, LOCKED, EXPIRED
  unlockAt           DateTime?
  lockAt             DateTime?
  postLockHoldMinutes Int     @default(4320) // Default 72 hours (4320 minutes)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questions Question[]
  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  proctoringWarnings ProctoringWarningLog[]
}

model StudentTestOverride {
  id              String   @id @default(uuid())
  studentId       String
  testId          String
  overrideUnlockAt DateTime?
  overrideLockAt   DateTime?
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([studentId, testId])
}

model TestAccessRequest {
  id        String   @id @default(uuid())
  studentId String
  testId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A", "B", "C", "D"
  explanation   String?
  difficulty    String   @default("Moderate") // Easy, Moderate, Difficult
  category      String?
  imageUrl      String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       Answer[]
}

model TestAttempt {
  id               String    @id @default(uuid())
  testId           String
  studentId        String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  status           String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  submissionReason String?   // MANUAL_SUBMISSION, TIME_EXPIRED, TAB_SWITCH, INACTIVITY_240_SECONDS, etc.
  attemptNumber    Int       @default(1)
  
  score            Float?
  percentage       Float?
  correctCount     Int?
  incorrectCount   Int?
  unansweredCount  Int?
  
  questionShufflings Json?   // Stores option shuffling mappings: { questionId: { "A": "C", "B": "A", ... } }

  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          Answer[]
  proctoringWarnings ProctoringWarningLog[]
}

model Answer {
  id             String      @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String?     // "A", "B", "C", "D"
  isCorrect      Boolean?
  answeredAt     DateTime    @default(now())

  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId])
}

model ProctoringSetting {
  id                           String   @id @default("default")
  enforceFullscreen            Boolean  @default(true)
  enableAiProctoring           Boolean  @default(true)
  faceAbsenceDelaySeconds      Int      @default(10)
  maxAllowedWarnings           Int      @default(5)
  tabSwitchAction              String   @default("AUTO_SUBMIT") // AUTO_SUBMIT, WARNING, ALLOW
  enableAudioProctoring        Boolean  @default(true)
  audioNoiseDelaySeconds       Int      @default(10)
  maxAudioWarnings             Int      @default(3)
  enableMobileEnvironmentScan  Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

model ProctoringWarningLog {
  id             String   @id @default(uuid())
  studentId      String
  testId         String
  attemptId      String
  warningType    String   // EYE_SLIP, AUDIO_NOISE
  message        String
  mediaUrl       String?
  questionNumber Int?
  questionText   String?
  createdAt      DateTime @default(now())

  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test           Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // PDF, IMAGE, LINK
  url         String
  fileSize    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


