generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String?
  name      String?
  phone     String?
  gender    String?  @default("Male")
  dob       DateTime?
  board     String?  @default("CBSE")
  academicLevel String? @default("11")
  otp       String?
  otpExpiry DateTime?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  subscriptionStatus String @default("FREE") // FREE, PAID
  subscriptionExpiresAt DateTime?
  avatarUrl String?  @default("/avatars/atom.jpg")
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  upgradeRequests SubscriptionUpgradeRequest[]
  proctoringWarnings ProctoringWarningLog[]
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Test {
  isPremium           Boolean  @default(false)
  id                 String   @id @default(uuid())
  title              String
  description        String?
  durationMinutes    Int
  totalQuestions     Int      @default(50)
  marksPerQuestion   Float    @default(1.0)
  negativeMarking    Boolean  @default(false)
  negativeMarks      Float    @default(0.0)
  maximumAttempts    Int      @default(1)
  randomizeQuestions Boolean  @default(false)
  randomizeOptions   Boolean  @default(false)
  status             String   @default("DRAFT") // DRAFT, PUBLISHED, LOCKED, EXPIRED
  unlockAt           DateTime?
  lockAt             DateTime?
  postLockHoldMinutes Int     @default(4320) // Default 72 hours (4320 minutes)
  targetBoard        String?  @default("ALL") // ALL, CBSE, ICSE, WBCHSE
  targetAcademicLevel String? @default("ALL") // ALL, 11, 12, SEM-I, SEM-II, SEM-III, SEM-IV
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questions Question[]
  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  proctoringWarnings ProctoringWarningLog[]
}

model StudentTestOverride {
  id              String   @id @default(uuid())
  studentId       String
  testId          String
  overrideUnlockAt DateTime?
  overrideLockAt   DateTime?
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([studentId, testId])
}

model TestAccessRequest {
  id        String   @id @default(uuid())
  studentId String
  testId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A", "B", "C", "D"
  explanation   String?
  difficulty    String   @default("Moderate") // Easy, Moderate, Difficult
  category      String?
  imageUrl      String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       Answer[]
}

model TestAttempt {
  id               String    @id @default(uuid())
  testId           String
  studentId        String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  status           String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  submissionReason String?   // MANUAL_SUBMISSION, TIME_EXPIRED, TAB_SWITCH, INACTIVITY_240_SECONDS, etc.
  attemptNumber    Int       @default(1)
  
  score            Float?
  percentage       Float?
  correctCount     Int?
  incorrectCount   Int?
  unansweredCount  Int?
  
  questionOrder    Json?
  questionShufflings Json?   // Stores option shuffling mappings: { questionId: { "A": "C", "B": "A", ... } }
  timeSpentSeconds   Int?      @default(0)
  resumedAt          DateTime?
  extraTimeMinutes   Int?      @default(0)
  previousAnswersSnapshot Json?

  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          Answer[]
  proctoringWarnings ProctoringWarningLog[]
}

model Answer {
  id             String      @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String?     // "A", "B", "C", "D"
  isCorrect      Boolean?
  answeredAt     DateTime    @default(now())
  previousAnswer      String?
  isChangedInResume   Boolean?    @default(false)
  isFreshInResume     Boolean?    @default(false)

  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId])
}

model ProctoringSetting {
  id                           String   @id @default("default")
  enforceFullscreen            Boolean  @default(true)
  enableAiProctoring           Boolean  @default(true)
  faceAbsenceDelaySeconds      Int      @default(10)
  maxAllowedWarnings           Int      @default(5)
  tabSwitchAction              String   @default("AUTO_SUBMIT") // AUTO_SUBMIT, WARNING, ALLOW
  enableAudioProctoring        Boolean  @default(true)
  audioNoiseDelaySeconds       Int      @default(10)
  maxAudioWarnings             Int      @default(3)
  enableMobileEnvironmentScan  Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

model ProctoringWarningLog {
  id             String   @id @default(uuid())
  studentId      String
  testId         String
  attemptId      String
  warningType    String   // EYE_SLIP, AUDIO_NOISE
  message        String
  mediaUrl       String?
  questionNumber Int?
  questionText   String?
  createdAt      DateTime @default(now())

  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test           Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model StudyMaterial {
  isPremium   Boolean  @default(false)
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // PDF, IMAGE, LINK
  url         String
  fileSize    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestAlertSetting {
  id           String   @id @default("default")
  badgeText    String   @default("TEST ALERT")
  bgGradient   String   @default("from-amber-950/90 via-yellow-900/70 to-amber-950/90")
  badgeColor   String   @default("bg-amber-500 text-black")
  textColor    String   @default("text-amber-200")
  marqueeSpeed String   @default("normal") // slow, normal, fast
  customNotice String?  @default("")
  updatedAt    DateTime @updatedAt
}

model SubscriptionUpgradeRequest {
  utrNumber String?
  amount    Float?   @default(99.0)
  id        String   @id @default(uuid())
  studentId String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model PaymentSetting {
  id           String   @id @default("default")
  upiId        String   @default("9830507435@upi")
  payeeName    String   @default("Arghyadeep Roy")
  monthlyFee   Float    @default(99.0)
  qrImageUrl   String?  @default("")
  
  // Paytm Business Gateway Configs
  paytmMid         String?  @default("")
  paytmMerchantKey String?  @default("")
  paytmWebsite     String?  @default("DEFAULT") // DEFAULT or WEBSTAGING
  paytmMode        String?  @default("TEST") // TEST or LIVE
  
  updatedAt    DateTime @updatedAt
}

model PaytmTransaction {
  id            String   @id @default(uuid())
  orderId       String   @unique
  studentId     String
  amount        Float
  txnId         String?
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  gatewayResponse Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}