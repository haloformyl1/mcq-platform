generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String?
  name      String?
  otp       String?
  otpExpiry DateTime?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  proctoringViolations ProctoringViolation[]
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Test {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  durationMinutes    Int
  totalQuestions     Int      @default(50)
  marksPerQuestion   Float    @default(1.0)
  negativeMarking    Boolean  @default(false)
  negativeMarks      Float    @default(0.0)
  maximumAttempts    Int      @default(1)
  randomizeQuestions Boolean  @default(false)
  randomizeOptions   Boolean  @default(false)
  status             String   @default("DRAFT") // DRAFT, PUBLISHED, LOCKED, EXPIRED
  unlockAt           DateTime?
  lockAt             DateTime?
  postLockHoldMinutes Int     @default(4320) // Default 72 hours (4320 minutes)
  eyeSlipDurationSeconds Int   @default(10)   // Duration for 1st eye slip warning (3s, 5s, 10s, 15s, 20s, 30s)
  maxPhoneWarnings       Int   @default(1)    // Max allowed cell phone warnings before auto-submit
  maxMultiPersonWarnings Int   @default(1)    // Max allowed multiple person warnings before auto-submit
  maxEyeSlipWarnings     Int   @default(3)    // Max allowed eye slip warnings before auto-submit
  maxTotalWarnings       Int   @default(3)    // Total cumulative warnings allowed before auto-submit
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  questions Question[]
  attempts  TestAttempt[]
  studentOverrides StudentTestOverride[]
  accessRequests TestAccessRequest[]
  proctoringViolations ProctoringViolation[]
}

model StudentTestOverride {
  id              String   @id @default(uuid())
  studentId       String
  testId          String
  overrideUnlockAt DateTime?
  overrideLockAt   DateTime?
  createdAt       DateTime @default(now())

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  @@unique([studentId, testId])
}

model TestAccessRequest {
  id        String   @id @default(uuid())
  studentId String
  testId    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test      Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String   // "A", "B", "C", "D"
  explanation   String?
  difficulty    String   @default("Moderate") // Easy, Moderate, Difficult
  category      String?
  imageUrl      String?
  orderIndex    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       Answer[]
}

model TestAttempt {
  id               String    @id @default(uuid())
  testId           String
  studentId        String
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  status           String    @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED
  submissionReason String?   // MANUAL_SUBMISSION, TIME_EXPIRED, TAB_SWITCH, INACTIVITY_240_SECONDS, etc.
  attemptNumber    Int       @default(1)
  
  score            Float?
  percentage       Float?
  correctCount     Int?
  incorrectCount   Int?
  unansweredCount  Int?
  
  questionShufflings Json?   // Stores option shuffling mappings: { questionId: { "A": "C", "B": "A", ... } }

  test             Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers          Answer[]
  proctoringViolations ProctoringViolation[]
}

model Answer {
  id             String      @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String?     // "A", "B", "C", "D"
  isCorrect      Boolean?
  answeredAt     DateTime    @default(now())

  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  @@unique([attemptId, questionId])
}

model ProctoringViolation {
  id             String      @id @default(uuid())
  attemptId      String
  studentId      String
  testId         String
  violationType  String      // CELL_PHONE_DETECTED, MULTIPLE_PERSONS_DETECTED, EYE_SLIP_10S, TAB_SWITCH, WINDOW_BLUR
  message        String
  snapshotBase64 String?     @db.Text
  warningNumber  Int
  createdAt      DateTime    @default(now())

  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test           Test        @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempt        TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}
